# Kopieren nach ~/.config/social-mcp/.env (oder .env im Startordner) und ausfüllen.
# Diese Datei niemals mit echten Werten committen.

# OAuth-Redirect, muss in allen Entwickler-Apps eingetragen sein
SOCIAL_MCP_REDIRECT_URI=http://localhost:8765/callback

# LinkedIn – https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional, Format YYYYMM; Standard: vor zwei Monaten
# LINKEDIN_API_VERSION=

# YouTube – Google Cloud Console, OAuth-Client vom Typ "Desktop-App"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram – Meta App Dashboard, "Instagram API mit Instagram-Login"
# (nicht nötig, wenn du `social-mcp auth instagram --token ...` nutzt)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# INSTAGRAM_API_VERSION=v23.0
